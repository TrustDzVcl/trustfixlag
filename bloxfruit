local env = (getgenv and getgenv()) or _G
if env.TrustPremiumCleanup then pcall(env.TrustPremiumCleanup) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local CONFIG = {
    HeightOffset = 7.5,
    MaxRange = 400,
    SkillKeys = {
        Enum.KeyCode.One,
        Enum.KeyCode.Two,
        Enum.KeyCode.Three,
        Enum.KeyCode.Four,
        Enum.KeyCode.Five,
    },
    SkillInterval = 0.25,
    KeyHold = 0.05,
    TargetRefresh = 0.1,
}

local State = {
    AutoFarm = false,
    AutoSkill = true,
}

local Connections = {}
local alive = true
local currentTarget = nil

local function track(conn)
    table.insert(Connections, conn)
    return conn
end

local MouseUtil
pcall(function()
    local utils = ReplicatedStorage:WaitForChild("Utilities", 10)
    MouseUtil = require(utils:WaitForChild("MouseUtil", 10))
end)

local originalGetTarget
if type(MouseUtil) == "table" and type(MouseUtil.GetTarget) == "function" then
    originalGetTarget = MouseUtil.GetTarget
    MouseUtil.GetTarget = function(...)
        if State.AutoFarm and currentTarget and currentTarget.Parent then
            return currentTarget.Position
        end
        return originalGetTarget(...)
    end
end

local function getClosestEnemy()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end

    local best, bestDist = nil, CONFIG.MaxRange
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local eRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            if hum and hum.Health > 0 and eRoot then
                local d = (root.Position - eRoot.Position).Magnitude
                if d < bestDist then
                    best, bestDist = eRoot, d
                end
            end
        end
    end
    return best
end

task.spawn(function()
    while alive do
        if State.AutoFarm then
            currentTarget = getClosestEnemy()
        else
            currentTarget = nil
        end
        task.wait(CONFIG.TargetRefresh)
    end
end)

track(RunService.Heartbeat:Connect(function()
    if not (alive and State.AutoFarm) then
        return
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local target = currentTarget
    if root and target and target.Parent then
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(
            target.Position + Vector3.new(0, CONFIG.HeightOffset, 0),
            target.Position
        )
end
end))

task.spawn(function()
    while alive do
        if State.AutoFarm and State.AutoSkill and currentTarget and currentTarget.Parent then
            for _, key in ipairs(CONFIG.SkillKeys) do
                if not (alive and State.AutoFarm and State.AutoSkill) then
                    break
                end
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(CONFIG.KeyHold)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
                task.wait(0.05)
            end
        end
        task.wait(CONFIG.SkillInterval)
    end
end)

local gui = Instance.new("ScreenGui")
gui.Name = "TrustPremium"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
local guiOk = false
if gethui then
    guiOk = pcall(function()
        gui.Parent = gethui()
    end)
end
if not guiOk or not gui.Parent then
    local ok = pcall(function()
        gui.Parent = CoreGui
    end)
    if not ok or not gui.Parent then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end

local function makeToggle(name, y, default, onChange)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.fromOffset(160, 36)
    btn.Position = UDim2.new(0.5, -80, 0, y)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = gui

    local value = default
    local function render()
        btn.Text = name .. ": " .. (value and "ON" or "OFF")
        btn.BackgroundColor3 = value and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    end
    render()

    track(btn.MouseButton1Click:Connect(function()
        value = not value
        render()
        onChange(value)
    end))
    return btn
end

makeToggle("AutoFarm", 10, false, function(v)
    State.AutoFarm = v
end)
makeToggle("AutoSkill", 54, true, function(v)
    State.AutoSkill = v
end)

if not originalGetTarget then
    warn("[TrustPremium] Không hook được MouseUtil.GetTarget, skill có thể vẫn lệch vị trí.")
end

env.TrustPremiumCleanup = function()
    alive = false
    State.AutoFarm = false
    if originalGetTarget and type(MouseUtil) == "table" then
        MouseUtil.GetTarget = originalGetTarget
    end
    for _, conn in ipairs(Connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(Connections)
    if gui then
        gui:Destroy()
    end
    env.TrustPremiumCleanup = nil
end